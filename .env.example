# Copy this file to `.env` and fill in the values.
#
# Supabase — find both under Project Settings → API in the Supabase dashboard.
# Everything prefixed with VITE_ is bundled into the browser code, so only the
# project URL and the publishable (formerly "anon") key belong here.
# Never put a secret / service_role key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
